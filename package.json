{
	"name": "@natlibfi/fixura",
	"description": "Loading test fixtures is as easy as ABC",
	"author": {
		"name": "The National Library of Finland"
	},
	"keywords": [
		"fixture",
		"test",
		"unit"
	],
	"homepage": "https://www.npmjs.com/package/@natlibfi/fixura",
	"bugs": {
		"url": "https://github.com/natlibfi/fixura-js/issues"
	},
	"repository": {
		"url": "https://github.com/NatLibFi/fixura-js"
	},
	"license": "MIT",
	"version": "5.0.0-alpha.7",
	"main": "./dist/index.js",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepare": "npm run build",
		"build": "tsc",
		"lint": "eslint ./src",
		"lint:dev": "eslint --fix ./src",
		"test:base": "node --test --experimental-test-coverage --test-reporter=spec './src/*.test.ts'",
		"test": "npm run lint && npm run test:base",
		"watch:test": "cross-env DEBUG=@natlibfi/* NODE_ENV=test node --watch --test --experimental-test-coverage --test-reporter=spec './src/*.test.ts'",
		"dev": "npm run watch:test",
		"dev:debug": "cross-env LOG_LEVEL=debug DEBUG=@natlibfi/* NODE_ENV=test npm run watch:test"
	},
	"dependencies": {
		"debug": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^26.1.0",
		"cross-env": "^10.1.0",
		"eslint": "^10.6.0",
		"jiti": "^2.7.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.63.0"
	}
}